
%include "memory"
%include "math"
%include "procedures"
%include "control"
%include "structs"
%include "exceptions"


;; header file with generic utility for system & context calls

%namespace sys {
;; arguments
	%macro argimm(value) {
		sysargw %value
	}
	%macro nullptr() {
		%argimm(0)
	}
	; push r as sysarg
	%macro argr() {
		sysargw(r)
	}
	; push value in seg as sysarg
	%macro argw(seg_name, idx) {
		%seg:load(%seg_name, %idx)
		%argr()
	}
	; push qword value from seg as sysarg
	%macro argq(seg_name, idx) {
		%seg:load_addr(%seg_name, %idx)
		sysargq(r)
	}
	; push address of segment as sysarg
	%macro addr(seg_name, idx) {
		%seg:move(%seg_name, %idx)
		sysaddr(h)
	}
	; push address of segment + offset from r
	%macro addr_offset(seg_name) {
		%sys:addr(%dest, 0)
		%offsetr()
	}
	; push memory pointer in segment as sysarg
	%macro ptr(seg_name, idx) {
		%seg:load(%seg_name, %idx)
		sysaddr(r)
	}
	; offset last system argument by r
	%macro offsetr() {
		sysoffset(r)
	}
	
	; push address to temp segment
	%macro tempaddr() {
		sysaddr %temp_addr
	}
	; push qword from temp segment
	%macro tempq() {
		sysargq %temp_addr
	}

;; return values
	; save last syscall return value to seg
	%macro retto(seg_name, idx) {
		%seg:move(%seg_name, %idx)
		sysretq(h)
	}
	; save last syscall return value to addr pointer by seg
	%macro retptr(seg_name, idx) {
		%seg:move(%seg_name, %idx)
		sysretq(m)
	}
	; save last retval to temp
	%macro rettemp() {
		mov %temp_addr
		sysretq(h)
	}

;; calling
	%macro _call_checked(callInstr, inCtxcall, instrs_check_retval) {
		%callInstr
		%storer(%temp_addr)
		%if {
			%instrs_check_retval
			leq 0
		,
			%stack:push(%inCtxcall)
			ld proc_seeLastError ; NOTE call() is overloaded
			; TODOO if filesystem is included -> undefined label
			%call_ptr()
		}
		%load(%temp_addr) ; -> returncode
	}
	%macro call(syscall_name, instrs_check_retval) {
		%_call_checked( syscall %syscall_name, 0, %instrs_check_retval )
	}
	%macro ctx(ctxcall_name, ignore_retval) {
		%_call_checked( ctxcall %ctxcall_name, 1,
			lne %minus1
			ld| %ignore_retval
		)
	}
}

;; context calls -------------------------

; enums
%namespace TokenTypes {
%struct:begin()
	%define Tnone (%minus1)
	%struct:field(Tnumeric, 1)
	%struct:field(Talpha, 1)
	%struct:field(Tstring, 1)
	%struct:field(Tchar, 1)
	%struct:field(Tspecial, 1)
	%struct:field(Tcolon, 1)
	%struct:field(Tseparator, 1)
	%struct:field(Tlist, 1)
; readonly
	%struct:field(TImodule, 1)
	%struct:field(TIexpansion, 1)
	%struct:field(TIctime, 1)
	%struct:field(TInamespace, 1)
	%struct:field(TIarglist, 1)
	%struct:field(TImacArg, 1)
	%struct:field(TItokenizer, 1)

%struct:end()
}

%namespace TokenMeta {
	%struct:begin()
	%struct:field(type, 1)
	%struct:field(firstOnLine, 1)
	%struct:field(continued, 1)
	%struct:field(row, 1)
	%struct:field(col, 1)

	%macro init() {
		%set(type, %TokenTypes:Tnone)
		%set(firstOnLine, 1)
		%set(continued, 0)
		%set(row, %minus1)
		%set(col, %minus1)
	}
	%macro deinit() {}

	%struct:end()
}


%namespace ctx {
	%macro call(ctxcall_name, ignore_retval) {
		%sys:ctx(%ctxcall_name, %ignore_retval)
	}
}

; seeLastError() for error reporting
%include "filesystem"
