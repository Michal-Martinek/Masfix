; compile time interfacing with compiler

%include "math"
%include "structs"

%namespace TokenTypes {
%struct:begin()
	%define Tnone (%minus1)
	%struct:field(Tnumeric, 1)
	%struct:field(Talpha, 1)
	%struct:field(Tstring, 1)
	%struct:field(Tchar, 1)
	%struct:field(Tspecial, 1)
	%struct:field(Tcolon, 1)
	%struct:field(Tseparator, 1)
	%struct:field(Tlist, 1)
; readonly
	%struct:field(TImodule, 1)
	%struct:field(TIexpansion, 1)
	%struct:field(TIctime, 1)
	%struct:field(TInamespace, 1)
	%struct:field(TIarglist, 1)
	%struct:field(TImacArg, 1)

%struct:end()
}

%namespace TokenMeta {
	%struct:begin()
	%struct:field(type, 1)
	%struct:field(firstOnLine, 1)
	%struct:field(continued, 1)
	%struct:field(row, 1)
	%struct:field(col, 1)

	%struct:end()
}
